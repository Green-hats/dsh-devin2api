{
  "name": "dsh-devin2api",
  "version": "0.1.0",
  "description": "Devin2API model provider for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "Green-hats",
  "homepage": "https://github.com/Green-hats/dsh-devin2api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Green-hats/dsh-devin2api.git"
  },
  "bugs": {
    "url": "https://github.com/Green-hats/dsh-devin2api/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "devin",
    "devin-2api",
    "llm",
    "provider"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/protocol.js && node --check lib/catalog.js && node --check lib/schema.js"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
